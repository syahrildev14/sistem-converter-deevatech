# Contoh .env untuk VPS + Nginx + Cloudflare (converter.deevatech.my.id)
# Pakai:  cp deploy/env.production.example .env   lalu isi ACCESS_PIN & AUTH_SECRET.

# --- Akses (WAJIB) ---
ACCESS_PIN=
# isi dengan: openssl rand -hex 32
AUTH_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=true

# --- Hanya bisa diakses Nginx di server yang sama ---
HOST_BIND=127.0.0.1
HOST_PORT=3000

# --- Cloudflare membatasi upload 100 MB per request ---
MAX_UPLOAD_MB=95
MAX_DURATION_MINUTES=180
FILE_TTL_MINUTES=30
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_TIMEOUT_MINUTES=30

# --- Kecepatan ---
FFMPEG_THREADS=
VIDEO_PRESET=veryfast
MAX_VIDEO_HEIGHT=1080
MP3_ALGORITHM_QUALITY=5

# --- Sumber URL ---
ENABLE_URL_SOURCE=true
ALLOWED_URL_HOSTS=
ALLOW_PRIVATE_URLS=false
# YouTube sering berubah: update yt-dlp tiap container start
YTDLP_AUTO_UPDATE=true
# Isi bila YouTube meminta verifikasi bot (lihat README), mis. /run/secrets/cookies.txt
YTDLP_COOKIES_FILE=
YTDLP_VERSION=latest
