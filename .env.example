# Salin ke .env lalu sesuaikan:  cp .env.example .env
# Semua variabel opsional; nilai di bawah adalah default.

# ===== Akses =====
# PIN/password tim. KOSONG = tanpa login (hanya untuk jaringan yang benar-benar tertutup).
ACCESS_PIN=
# Rahasia tambahan untuk menandatangani cookie sesi. Isi string acak panjang (mis. `openssl rand -hex 32`).
AUTH_SECRET=
# Lama sesi login (jam).
SESSION_HOURS=12
# true jika diakses lewat HTTPS (reverse proxy) agar cookie hanya dikirim via HTTPS.
COOKIE_SECURE=false

# ===== Port (docker compose) =====
# 127.0.0.1 = hanya bisa diakses reverse proxy di server yang sama (disarankan). 0.0.0.0 = terbuka ke jaringan.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# ===== Batas & pembersihan =====
# File hasil dihapus otomatis setelah N menit.
FILE_TTL_MINUTES=30
# Ukuran maksimal upload / unduhan dari URL (MB).
MAX_UPLOAD_MB=500
# Durasi media maksimal (menit).
MAX_DURATION_MINUTES=180
# Job konversi yang berjalan bersamaan (1-2). Sisanya masuk antrean.
MAX_CONCURRENT_JOBS=2
# Total job (berjalan + antre) sebelum permintaan baru ditolak.
MAX_QUEUED_JOBS=20
# Job yang melebihi batas waktu ini (menit) dihentikan paksa.
JOB_TIMEOUT_MINUTES=30

# ===== Tuning kecepatan =====
# Thread ffmpeg per job. Kosong = otomatis (jumlah CPU / MAX_CONCURRENT_JOBS).
FFMPEG_THREADS=
# Preset x264 saat MP4 harus di-transcode: ultrafast|superfast|veryfast|faster|fast|medium
VIDEO_PRESET=veryfast
# Tinggi video maksimal (px) untuk unduhan & transcode MP4.
MAX_VIDEO_HEIGHT=1080
# Kualitas algoritma LAME 0 (lambat, terbaik) - 9 (tercepat). 5 = cepat, kualitas tetap baik.
MP3_ALGORITHM_QUALITY=5

# ===== Sumber URL (yt-dlp) =====
# false = hanya upload file.
ENABLE_URL_SOURCE=true
# Batasi domain sumber, pisahkan koma (mis. youtube.com,youtu.be,vimeo.com). Kosong = semua domain publik.
ALLOWED_URL_HOSTS=
# true = izinkan URL ke IP privat/LAN (mis. NAS internal). Default diblokir (proteksi SSRF).
ALLOW_PRIVATE_URLS=false
# true = jalankan `yt-dlp -U` setiap container start.
YTDLP_AUTO_UPDATE=false
# Path file cookies (format Netscape) di dalam container untuk sumber yang butuh login. Mount via volume.
YTDLP_COOKIES_FILE=
# Versi yt-dlp saat build image (tag rilis GitHub, mis. 2026.11.01) atau "latest".
YTDLP_VERSION=latest

# ===== Hanya untuk development lokal (di Docker sudah diatur) =====
# STORAGE_DIR=./storage
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# YTDLP_PATH=yt-dlp
# YTDLP_JS_RUNTIMES=node
